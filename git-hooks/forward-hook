#!/usr/bin/env bash
set -euo pipefail

# Pass-through wrapper so global core.hooksPath preserves repo-local hooks (commit-msg, pre-push, etc.)
HOOK_NAME="$(basename "$0")"
GIT_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || git rev-parse --git-common-dir 2>/dev/null || true)"

if [[ -n "${GIT_COMMON_DIR}" ]]; then
  LOCAL_HOOK="${GIT_COMMON_DIR}/hooks/${HOOK_NAME}"
  SELF_REAL="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/${HOOK_NAME}"
  if [[ -f "${LOCAL_HOOK}" && -x "${LOCAL_HOOK}" ]]; then
    LOCAL_REAL="$(cd "$(dirname "${LOCAL_HOOK}")" && pwd -P)/${HOOK_NAME}"
    if [[ "${LOCAL_REAL}" != "${SELF_REAL}" ]]; then
      exec "${LOCAL_HOOK}" "$@"
    fi
  fi
fi
